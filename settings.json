{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bin/exec go:*)",
      "Bash(bin/exec gofmt:*)",
      "Bash(bin/yarn:*)",
      "Bash(go build:*)",
      "Bash(go generate:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(gofmt:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/gofmt-on-edit.sh"
          }
        ]
      }
    ]
  }
}
